# Neon PostgreSQL — pooled connection (used by the app at runtime)
DATABASE_URL=

# Neon PostgreSQL — direct/unpooled connection (used by drizzle-kit for migrations)
DATABASE_URL_UNPOOLED=

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# Optional explicit app URL (fallbacks to VERCEL_URL or http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# UploadThing API token — get from https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=

# Resend API key and sender email
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com

# Google OAuth — get from https://console.cloud.google.com
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub OAuth — get from https://github.com/settings/developers
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Auth.js — trust the Host header from the reverse proxy / request
# (required for non-Vercel deployments so Auth.js infers the correct origin)
AUTH_TRUST_HOST=true

# Public i18n default locale (allowed: hu, en)
NEXT_PUBLIC_DEFAULT_LOCALE=hu

# Optional: secure shared secret for cron endpoints
CRON_SECRET=

# Optional runtime mode (development | test | production)
NODE_ENV=development
